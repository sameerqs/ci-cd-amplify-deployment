# Runtime
ENV=development
APP_NAME=Pet2text
PORT=8000
FRONTEND_URL=http://localhost:3000
# Extra CORS origins, comma-separated (FRONTEND_URL is always allowed)
CORS_ORIGINS=
LOG_LEVEL=INFO
# Defaults to true in uat/production, false otherwise.
LOG_JSON=

# Database (required). postgresql:// is normalised to postgresql+asyncpg://
DATABASE_URL=postgresql://pet2text:change-me@localhost:5432/pet2text_fastapi
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Auth. PEPPER_SECRET is required and must be >= 32 chars; never default it.
# It also derives the session vault's encryption key unless you set one below.
PEPPER_SECRET=

# How long a signed-in device stays signed in. Keep at or under the app client's
# refresh-token validity in Cognito, or sessions die with no explanation.
SESSION_EXPIRES_IN=30d

# Encrypts the Cognito refresh token held in auth_sessions. Leave blank and the
# vault derives its own key from PEPPER_SECRET -- one fewer secret to manage.
# Set it (a Fernet key: urlsafe base64 of 32 bytes) to rotate the vault on its
# own. Rotating it signs everyone out; it does not corrupt anything.
SESSION_ENCRYPTION_KEY=

# Sets the Secure flag on the session cookie this API writes. A Secure cookie is
# dropped silently by the browser over plain HTTP, so local development on
# http://localhost needs this false. Never false in production.
COOKIE_SECURE=true

# AWS. One region for the account and one identity for everything in it:
# Cognito and, unless overridden below, S3. Leave the keys blank in AWS and let
# the instance role supply them -- boto3 only receives them when set here.
#
# IAM needs cognito-idp:AdminGetUser and cognito-idp:AdminCreateUser. The auth
# calls themselves are token-authorized and need no IAM grant.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito is the only way into this application: it runs the passwordless
# CUSTOM_AUTH flow, issues the tokens, and this service verifies them. A
# production process refuses to start without a complete pool config, which is
# what stops a half-configured pool from accepting tokens it should not.
# Development and CI may leave these blank and simply have no way to sign in.
#
# The pool needs the three custom-auth Lambda triggers deployed before any of
# this works; see lambdas/cognito_custom_auth/README.md for the contract and the
# required app-client settings (ALLOW_CUSTOM_AUTH, refresh tokens, revocation --
# 'Revoke token' must stay enabled or sign-out cannot kill the session).
#
# One app client, created WITHOUT a client secret. There is no second public
# client: the browser never talks to Cognito directly, so it has no client id
# of its own. Nothing here computes a SECRET_HASH, so an app client that does
# have a secret would make every auth call fail.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# How long a sign-in link stays good. The access token's own lifetime is set on
# the Cognito app client, not here -- 15 minutes is a sensible value there.
MAGIC_LINK_TOKEN_TTL_SECONDS=900

# Rate limiting (default limiter on protected routes; auth routes have their own)
THROTTLE_GENERAL_TTL=60000
THROTTLE_GENERAL_LIMIT=100

# Email (optional; set ENABLE_EMAIL=true and fill the EMAIL_* values to send)
ENABLE_EMAIL=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Pet2text <no-reply@example.com>

# LangChain / OpenAI (optional; LLM routes answer 503 while OPENAI_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2


# Tests only: separate database, migrated by the test suite
TEST_DATABASE_URL=postgresql://pet2text:change-me@localhost:5432/pet2text_fastapi_test

# Attachment storage. Leave S3_BUCKET unset to keep files on local disk
# (LOCAL_STORAGE_DIR) -- that is the default for dev and CI. Set the bucket to
# switch to S3; nothing else changes.
#
# Region and credentials fall back to the AWS_* values above, so set these only
# when the bucket lives in another region or under a different identity. Blank
# S3_REGION with no AWS_REGION falls back to us-east-1.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=var/attachments
ATTACHMENT_MAX_BYTES=52428800
# Request body ceiling. Note this is separate from ATTACHMENT_MAX_BYTES and
# must stay above it -- raising the attachment cap alone will not let a larger
# upload through if this does not grow with it.
BODY_LIMIT_BYTES=57671680

# The address promoted to Super Admin. Ensured on every app boot (app/main.py's
# lifespan calls the same idempotent check `uv run python -m scripts.seed` uses),
# so a fresh environment or a restored backup always has one without a manual
# step. There is no password: the account is a role and an approval, and it
# signs in through the same email link as everyone else.
SEED_ADMIN_EMAIL=
